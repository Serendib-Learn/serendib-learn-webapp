# Where the browser reaches the API service in server/.
# Copy this file to .env.local. Without it the app assumes localhost:4000.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client id, shared with server/.env's GOOGLE_CLIENT_ID.
# Empty hides the "Sign in with Google" button entirely. See server/README.md
# for how to create one and what to add for Calendar + Meet.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
