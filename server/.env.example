# Port the API listens on.
PORT=4000

# Origins allowed to send credentialed requests, comma separated.
CORS_ORIGINS=http://localhost:3000

# MongoDB connection string (Atlas or otherwise). Unset means the JSON file
# store is used instead — no setup needed, but not what production should run
# on. See "Database" in DEPLOYMENT.md for creating a free Atlas cluster.
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
# MONGODB_DB_NAME=serendib_learn

# Where the JSON document store writes when MONGODB_URI is unset. Defaults to
# server/data/db.json.
# DATA_FILE=./data/db.json

# Session cookie. When the API and the site are on different domains you need
# SameSite=None, which browsers only accept over HTTPS.
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Leaves the demo mail inbox and the reset endpoint open. Set to false for
# anything that is not a demo.
DEMO_MODE=true

# Google OAuth client, from the same Google Cloud project as the frontend's
# NEXT_PUBLIC_GOOGLE_CLIENT_ID (they must be the same client id). Empty
# disables sign-in with Google entirely. See server/README.md for setup.
GOOGLE_CLIENT_ID=

# The client's secret. Only needed for the Calendar connection flow — sign-in
# alone does not use it. Empty disables "Connect Google Calendar" in the
# portal; sign-in keeps working without it.
GOOGLE_CLIENT_SECRET=

# Must exactly match an "Authorized redirect URI" on the OAuth client.
# GOOGLE_REDIRECT_URI=http://localhost:4000/api/integrations/google/callback

# Where the browser is sent back to once the Calendar consent screen finishes.
# APP_URL=http://localhost:3000
